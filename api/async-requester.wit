interface async-requester {
    // This interface contains function signature definitions that will be used
    // by the hyper-bindgen macro to generate async function bindings.
    //
    // NOTE: This is currently a hacky workaround since WIT async functions are not
    // available until WASI Preview 3. Once Preview 3 is integrated into Hyperware,
    // we should switch to using proper async WIT function signatures instead of
    // this struct-based approach with hyper-bindgen generating the async stubs.

    use standard.{address};

    // Function signature for: jaxs-ribs (http)
    record jaxs-ribs-signature-http {
        target: string,
        value: s32,
        returning: string
    }

    // Function signature for: increment-counter (local)
    record increment-counter-signature-local {
        target: address,
        value: s32,
        another-value: string,
        yet-another-value: f32,
        returning: string
    }

    // Function signature for: increment-counter-two (remote)
    record increment-counter-two-signature-remote {
        target: address,
        value: f64,
        another-value: list<string>,
        yet-another-value: bool,
        returning: list<s32>
    }

    // Function signature for: increment-counter-two (local)
    record increment-counter-two-signature-local {
        target: address,
        value: f64,
        another-value: list<string>,
        yet-another-value: bool,
        returning: list<s32>
    }

    // Function signature for: increment-counter-async (local)
    record increment-counter-async-signature-local {
        target: address,
        value: s32,
        name: string,
        returning: string
    }

    // Function signature for: some-other-function (remote)
    record some-other-function-signature-remote {
        target: address,
        string-val: string,
        another-string-val: string,
        returning: f32
    }

    // Function signature for: increment-counter-three (local)
    record increment-counter-three-signature-local {
        target: address,
        string-val: string,
        returning: f32
    }

    // Function signature for: increment-counter-three (http)
    record increment-counter-three-signature-http {
        target: string,
        string-val: string,
        returning: f32
    }

    // Function signature for: increment-counter-four (local)
    record increment-counter-four-signature-local {
        target: address,
        string-val: string,
        returning: f32
    }

    // Function signature for: increment-counter-four (http)
    record increment-counter-four-signature-http {
        target: string,
        string-val: string,
        returning: f32
    }
}
